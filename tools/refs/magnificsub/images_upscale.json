{
  "name": "images_upscale",
  "title": "Upscale Image",
  "description": "AI upscale 2x\u201316x (Magnific, premium): improve sharpness, quality and detail of an existing image while keeping its content intact. Call `images_upscale_modes_list` first to pick a `mode` and discover per-mode params. Defaults: mode=creative, scale=2x. Exact pixels: `images_resize`. Aspect: `images_crop`.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "creationIdentifier": {
        "description": "Image creation identifier (import uploads first).",
        "type": "string"
      },
      "mode": {
        "description": "From `images_upscale_modes_list`. Default creative.",
        "enum": [
          "creative",
          "ultra-sublime",
          "ultra-photo",
          "ultra-denoiser",
          "ultra"
        ],
        "type": "string"
      },
      "scale": {
        "description": "Default 2x; allowed values vary by mode.",
        "enum": [
          "2x",
          "4x",
          "8x",
          "16x"
        ],
        "type": "string"
      },
      "precisionPreset": {
        "description": "Slider macro; requires a precision mode.",
        "enum": [
          "balanced",
          "portraits",
          "grainyAnalog"
        ],
        "type": "string"
      },
      "presets": {
        "description": "Creative preset; default 'subtle'.",
        "enum": [
          "subtle",
          "vivid",
          "wild",
          "custom"
        ],
        "type": "string"
      },
      "optimised": {
        "description": "Creative subject-type preset; default StandardUltra.",
        "enum": [
          "StandardUltra",
          "SoftPortrait",
          "HardPortrait",
          "ArtAndIllustration",
          "VideoGameAssets",
          "NatureAndLandscapes",
          "FilmAndPhotography",
          "ThreeDRenders",
          "ScienceFictionAndHorror"
        ],
        "type": "string"
      },
      "engine": {
        "description": "Creative engine; default automatic.",
        "enum": [
          "automatic",
          "magnific_illusio",
          "magnific_sharpy",
          "magnific_sparkle"
        ],
        "type": "string"
      },
      "prompt": {
        "description": "Creative guidance prompt (max 2000 chars).",
        "type": "string"
      },
      "creativity": {
        "description": "Creative; -10..10.",
        "type": "integer"
      },
      "resemblance": {
        "description": "Creative; -10..10.",
        "type": "integer"
      },
      "hdr": {
        "description": "Creative; -10..10.",
        "type": "integer"
      },
      "fractality": {
        "description": "Creative; -10..10.",
        "type": "integer"
      },
      "sharpness": {
        "description": "Precision; 0..100.",
        "type": "integer"
      },
      "grain": {
        "description": "Precision; 0..100.",
        "type": "integer"
      },
      "ultraDetail": {
        "description": "Precision; 0..100. Not for ultra-sublime.",
        "type": "integer"
      },
      "folderReference": {
        "description": "From `folders_list`. Omit \u2192 the user's Personal project. Does NOT persist: once the user names a target, pass it on EVERY later generation/edit call.",
        "type": "string"
      }
    },
    "required": [
      "creationIdentifier"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "creation": {
        "properties": {
          "identifier": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "expectTime": {
            "description": "Seconds left; 0 once terminal.",
            "type": "integer"
          },
          "tool": {
            "type": "string"
          },
          "credits": {
            "type": "integer"
          },
          "creditsNote": {
            "type": "string"
          },
          "webUrl": {
            "type": "string"
          },
          "designerUrl": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "identifier",
          "status"
        ]
      },
      "creations": {
        "items": {
          "properties": {
            "identifier": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "expectTime": {
              "description": "Seconds left; 0 once terminal.",
              "type": "integer"
            },
            "tool": {
              "type": "string"
            },
            "credits": {
              "type": "integer"
            },
            "creditsNote": {
              "type": "string"
            },
            "webUrl": {
              "type": "string"
            },
            "designerUrl": {
              "type": "string"
            }
          },
          "type": "object",
          "required": [
            "identifier",
            "status"
          ]
        },
        "type": "array"
      },
      "partialFailure": {
        "description": "Some outputs queued, the rest stopped here.",
        "type": "string"
      },
      "instruction": {
        "type": "string"
      }
    },
    "required": [
      "instruction"
    ]
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "openWorldHint": false
  }
}